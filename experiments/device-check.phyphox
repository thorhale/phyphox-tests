<phyphox version="1.14" locale="en">
  <title>0. Device Check</title>
  <category>Data centre</category>
  <icon>CHK</icon>
  <description>
        WHAT IT DOES
        Finds out what your phone actually has inside it, and how good each part is.

        WHY YOU CARE
        Phones do not tell you what sensors they contain, and they differ enormously. Cheaper models often have no barometer. The cheapest have no gyroscope. Almost no phone has a real thermometer. Better to learn that at a desk than halfway down an aisle.

        It also measures something no spec sheet gives you: how many readings per second each sensor really produces. That number puts a hard ceiling on every other test here. A sensor read 100 times a second cannot detect anything vibrating faster than 50 times a second. That is arithmetic, not a software limit, and no clever programming gets around it.

        HOW TO RUN IT
        1. Put the phone flat on a table and take your hand off it.
        2. Press play.
        3. Wait about 30 seconds without touching it.
        4. Read the Sensors tab, then the What you can run tab.

        Do not hold it. A held phone is a moving phone, and your hand ruins the noise readings.

        WHEN
        Once per phone, ever. Then never again.
    </description>

  <data-containers>
    <container size="256">accV</container>
    <container size="256">accT</container>
    <container>accN</container>
    <container>accT0</container>
    <container>accTL</container>
    <container>accSpan</container>
    <container>accRate</container>
    <container>accMean</container>
    <container>accNoise</container>
    <container size="256">gyrV</container>
    <container size="256">gyrT</container>
    <container>gyrN</container>
    <container>gyrT0</container>
    <container>gyrTL</container>
    <container>gyrSpan</container>
    <container>gyrRate</container>
    <container>gyrMean</container>
    <container>gyrNoise</container>
    <container size="256">magV</container>
    <container size="256">magT</container>
    <container>magN</container>
    <container>magT0</container>
    <container>magTL</container>
    <container>magSpan</container>
    <container>magRate</container>
    <container>magMean</container>
    <container>magNoise</container>
    <container size="256">preV</container>
    <container size="256">preT</container>
    <container>preN</container>
    <container>preT0</container>
    <container>preTL</container>
    <container>preSpan</container>
    <container>preRate</container>
    <container size="256">lgtV</container>
    <container size="256">lgtT</container>
    <container>lgtN</container>
    <container>lgtT0</container>
    <container>lgtTL</container>
    <container>lgtSpan</container>
    <container>lgtRate</container>
    <container size="256">prxV</container>
    <container size="256">prxT</container>
    <container>prxN</container>
    <container>prxT0</container>
    <container>prxTL</container>
    <container>prxSpan</container>
    <container>prxRate</container>
    <container size="256">tmpV</container>
    <container size="256">tmpT</container>
    <container>tmpN</container>
    <container>tmpT0</container>
    <container>tmpTL</container>
    <container>tmpSpan</container>
    <container>tmpRate</container>
    <container size="256">humV</container>
    <container size="256">humT</container>
    <container>humN</container>
    <container>humT0</container>
    <container>humTL</container>
    <container>humSpan</container>
    <container>humRate</container>

    <container size="4096">recording</container>
    <container>micRate</container>
    <container>micN</container>

    <container>coreOk</container>
    <container>vibMax</container>
  </data-containers>

  <input>
    <sensor type="accelerometer" rate="0" ignoreUnavailable="true">
      <output component="abs">accV</output>
      <output component="t">accT</output>
    </sensor>
    <sensor type="gyroscope" rate="0" ignoreUnavailable="true">
      <output component="abs">gyrV</output>
      <output component="t">gyrT</output>
    </sensor>
    <sensor type="magnetic_field" rate="0" ignoreUnavailable="true">
      <output component="abs">magV</output>
      <output component="t">magT</output>
    </sensor>
    <sensor type="pressure" rate="0" ignoreUnavailable="true">
      <output component="x">preV</output>
      <output component="t">preT</output>
    </sensor>
    <sensor type="light" rate="0" ignoreUnavailable="true">
      <output component="x">lgtV</output>
      <output component="t">lgtT</output>
    </sensor>
    <sensor type="proximity" rate="0" ignoreUnavailable="true">
      <output component="x">prxV</output>
      <output component="t">prxT</output>
    </sensor>
    <sensor type="temperature" rate="0" ignoreUnavailable="true">
      <output component="x">tmpV</output>
      <output component="t">tmpT</output>
    </sensor>
    <sensor type="humidity" rate="0" ignoreUnavailable="true">
      <output component="x">humV</output>
      <output component="t">humT</output>
    </sensor>
    <audio append="true">
      <output>recording</output>
      <output component="rate">micRate</output>
    </audio>
  </input>

  <views>
    <view label="Sensors">
      <info label="Leave the phone still on a table for ten seconds - genuinely still, not held. Anything reading zero samples is not fitted to this phone. The light and proximity sensors are event driven: they report only when the reading changes, so a low sample rate from them is normal and not a fault."/>
      <separator height="0.5"/>
      <value label="Accelerometer">
        <input>accN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>accRate</input>
      </value>
      <value label="Gyroscope">
        <input>gyrN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>gyrRate</input>
      </value>
      <value label="Magnetometer">
        <input>magN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>magRate</input>
      </value>
      <value label="Barometer">
        <input>preN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>preRate</input>
      </value>
      <value label="Light sensor">
        <input>lgtN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>lgtRate</input>
      </value>
      <value label="Proximity">
        <input>prxN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>prxRate</input>
      </value>
      <value label="Ambient temperature">
        <input>tmpN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>tmpRate</input>
      </value>
      <value label="Humidity">
        <input>humN</input>
        <map max="0.5">NOT FITTED</map>
        <map max="20">fitted - reports only when it changes</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="1">
        <input>humRate</input>
      </value>
      <separator height="0.5"/>
      <value label="Microphone">
        <input>micN</input>
        <map max="0.5">NOT WORKING - check the permission</map>
        <map>working</map>
      </value>
      <value label="   its real sample rate" unit="Hz" precision="0">
        <input>micRate</input>
      </value>
    </view>

    <view label="Noise floor">
      <info label="How much each sensor wobbles while sitting perfectly still. This is the smallest change that test results can be trusted to show - anything below this is the sensor talking to itself."/>
      <separator height="0.5"/>
      <value label="Accelerometer noise" unit="m/s^2" precision="4">
        <input>accNoise</input>
      </value>
      <value label="Verdict">
        <input>accNoise</input>
        <map max="0.005">excellent</map>
        <map max="0.02">normal</map>
        <map max="0.1">noisy - is the phone really still?</map>
        <map>very noisy - something is vibrating, or the phone was moving</map>
      </value>
      <separator height="0.5"/>
      <value label="Magnetometer noise" unit="uT" precision="4">
        <input>magNoise</input>
      </value>
      <value label="Verdict">
        <input>magNoise</input>
        <map max="0.1">excellent</map>
        <map max="0.5">normal</map>
        <map max="2">noisy - move away from anything electrical</map>
        <map>very noisy - you are next to something magnetic already</map>
      </value>
      <separator height="0.5"/>
      <value label="Gyroscope noise" unit="rad/s" precision="5">
        <input>gyrNoise</input>
      </value>
    </view>

    <view label="What you can run">
      <value label="The 14 core tests">
        <input>coreOk</input>
        <map max="0.5">NO - a core sensor is missing</map>
        <map max="20">checking...</map>
        <map>YES - all of them work on this phone</map>
      </value>
      <info label="The core tests need only the accelerometer, magnetometer, microphone and speaker. That is everything from the sound meter to the fan tacho to magnetic positioning."/>
      <separator height="0.5"/>
      <value label="Pressure tests (hall survey, containment)">
        <input>preN</input>
        <map max="0.5">NO - this phone has no barometer</map>
        <map max="20">checking...</map>
        <map>YES</map>
      </value>
      <value label="Light readings in the walk logger">
        <input>lgtN</input>
        <map max="0.5">NO - normal on iPhone, phyphox cannot read it there</map>
        <map max="20">YES - but it only updates when the light changes</map>
        <map>YES</map>
      </value>
      <value label="Rotation tests">
        <input>gyrN</input>
        <map max="0.5">NO - this phone has no gyroscope</map>
        <map max="20">checking...</map>
        <map>YES</map>
      </value>
      <separator height="0.5"/>
      <value label="Highest vibration frequency this phone can see" unit="Hz" size="2" precision="0">
        <input>vibMax</input>
      </value>
      <info label="Above this frequency the accelerometer is blind, and worse, real vibration above it gets folded down and shows up as a fake peak at some lower frequency. It is half the accelerometer's real sample rate."/>
    </view>

    <view label="Notes">
      <info label="WHAT A SAMPLE RATE IS, AND WHY IT DECIDES EVERYTHING"/>
      <info label="A sensor does not watch continuously. It takes snapshots. The sample rate is how many snapshots it takes each second."/>
      <info label="There is a rule with no exceptions: to detect something that repeats, you must take snapshots MORE THAN TWICE as fast as it repeats. Miss that and you do not get a poor reading, you get a wrong one. So a sensor read 100 times a second tops out at 50 Hz, and everything above that is invisible to it."/>
      <info label="Hz just means times per second. 50 Hz is fifty times a second."/>
      <info label="This is why the fan test judges bearings by how SPIKY the vibration is rather than by its pitch. Bearing damage rattles at thousands of Hz and no phone accelerometer is anywhere near fast enough to hear that pitch. But it can still feel the spikes."/>
      <separator height="0.5"/>
      <info label="WHAT THE NOISE FLOOR IS"/>
      <info label="Leave a sensor completely still and it still twitches slightly. That twitch is the noise floor. It is the smallest change the sensor can honestly tell apart from its own fidgeting."/>
      <info label="If a test claims to spot something smaller than that, it is reading its own noise and reporting it as a finding. Watch the magnetometer figure in particular: it sets the smallest magnetic change the EMI and busway tests can truthfully see on this phone."/>
      <info label="If the numbers here look high, you were holding the phone. Put it down and run it again."/>
      <separator height="0.5"/>
      <info label="IF SOMETHING SAYS NOT FITTED"/>
      <info label="That is information, not a fault. Cheaper phones leave out the barometer and sometimes the gyroscope. The tests are built so a phone with only an accelerometer, a magnetometer, a microphone and a speaker still runs fourteen of them."/>
      <separator height="0.5"/>
      <info label="IF LIGHT OR PROXIMITY SHOWS A VERY LOW RATE"/>
      <info label="Also normal, also not a fault. Those two only speak up when the reading CHANGES. A phone lying still under a steady light has nothing to report, so it reports almost nothing. Wave your hand over the top of the screen and you will see them react."/>
      <separator height="0.5"/>
      <info label="TEMPERATURE AND HUMIDITY WILL ALMOST CERTAINLY SAY NOT FITTED"/>
      <info label="Expected. Hardly any phone built since about 2014 has either one. phyphox still offers them in its menus whether your phone has them or not, which is exactly why they are checked here."/>
      <info label="Phones do contain temperature sensors, but they measure the phone's own electronics warming up, not the room. That is why the Hall Survey asks you to type the temperature in by hand. If either ever says working on some phone, that is worth knowing."/>
      <separator height="0.5"/>
      <info label="KEEP THIS RESULT"/>
      <info label="Export it and save it somewhere. It is the record of what this particular phone can and cannot measure, and every later reading should be read against it. A number is only as good as the sensor that produced it."/>
    </view>
  </views>

  <analysis sleep="0.5">
    <count>
      <input clear="false">accT</input>
      <output clear="false">accN</output>
    </count>
    <first>
      <input as="value" clear="false">accT</input>
      <output as="first">accT0</output>
    </first>
    <max>
      <input as="y" clear="false">accT</input>
      <output as="max">accTL</output>
    </max>
    <subtract>
      <input>accTL</input>
      <input>accT0</input>
      <output>accSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">accN</input>
      <input>accSpan</input>
      <output clear="false">accRate</output>
    </formula>
    <average>
      <input as="buffer" clear="false">accV</input>
      <output as="average">accMean</output>
      <output as="stddev" clear="false">accNoise</output>
    </average>
    <count>
      <input clear="false">gyrT</input>
      <output clear="false">gyrN</output>
    </count>
    <first>
      <input as="value" clear="false">gyrT</input>
      <output as="first">gyrT0</output>
    </first>
    <max>
      <input as="y" clear="false">gyrT</input>
      <output as="max">gyrTL</output>
    </max>
    <subtract>
      <input>gyrTL</input>
      <input>gyrT0</input>
      <output>gyrSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">gyrN</input>
      <input>gyrSpan</input>
      <output clear="false">gyrRate</output>
    </formula>
    <average>
      <input as="buffer" clear="false">gyrV</input>
      <output as="average">gyrMean</output>
      <output as="stddev" clear="false">gyrNoise</output>
    </average>
    <count>
      <input clear="false">magT</input>
      <output clear="false">magN</output>
    </count>
    <first>
      <input as="value" clear="false">magT</input>
      <output as="first">magT0</output>
    </first>
    <max>
      <input as="y" clear="false">magT</input>
      <output as="max">magTL</output>
    </max>
    <subtract>
      <input>magTL</input>
      <input>magT0</input>
      <output>magSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">magN</input>
      <input>magSpan</input>
      <output clear="false">magRate</output>
    </formula>
    <average>
      <input as="buffer" clear="false">magV</input>
      <output as="average">magMean</output>
      <output as="stddev" clear="false">magNoise</output>
    </average>
    <count>
      <input clear="false">preT</input>
      <output clear="false">preN</output>
    </count>
    <first>
      <input as="value" clear="false">preT</input>
      <output as="first">preT0</output>
    </first>
    <max>
      <input as="y" clear="false">preT</input>
      <output as="max">preTL</output>
    </max>
    <subtract>
      <input>preTL</input>
      <input>preT0</input>
      <output>preSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">preN</input>
      <input>preSpan</input>
      <output clear="false">preRate</output>
    </formula>
    <count>
      <input clear="false">lgtT</input>
      <output clear="false">lgtN</output>
    </count>
    <first>
      <input as="value" clear="false">lgtT</input>
      <output as="first">lgtT0</output>
    </first>
    <max>
      <input as="y" clear="false">lgtT</input>
      <output as="max">lgtTL</output>
    </max>
    <subtract>
      <input>lgtTL</input>
      <input>lgtT0</input>
      <output>lgtSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">lgtN</input>
      <input>lgtSpan</input>
      <output clear="false">lgtRate</output>
    </formula>
    <count>
      <input clear="false">prxT</input>
      <output clear="false">prxN</output>
    </count>
    <first>
      <input as="value" clear="false">prxT</input>
      <output as="first">prxT0</output>
    </first>
    <max>
      <input as="y" clear="false">prxT</input>
      <output as="max">prxTL</output>
    </max>
    <subtract>
      <input>prxTL</input>
      <input>prxT0</input>
      <output>prxSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">prxN</input>
      <input>prxSpan</input>
      <output clear="false">prxRate</output>
    </formula>
    <count>
      <input clear="false">tmpT</input>
      <output clear="false">tmpN</output>
    </count>
    <first>
      <input as="value" clear="false">tmpT</input>
      <output as="first">tmpT0</output>
    </first>
    <max>
      <input as="y" clear="false">tmpT</input>
      <output as="max">tmpTL</output>
    </max>
    <subtract>
      <input>tmpTL</input>
      <input>tmpT0</input>
      <output>tmpSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">tmpN</input>
      <input>tmpSpan</input>
      <output clear="false">tmpRate</output>
    </formula>
    <count>
      <input clear="false">humT</input>
      <output clear="false">humN</output>
    </count>
    <first>
      <input as="value" clear="false">humT</input>
      <output as="first">humT0</output>
    </first>
    <max>
      <input as="y" clear="false">humT</input>
      <output as="max">humTL</output>
    </max>
    <subtract>
      <input>humTL</input>
      <input>humT0</input>
      <output>humSpan</output>
    </subtract>
    <formula formula="max([1]-1,0)/max([2],0.001)">
      <input clear="false">humN</input>
      <input>humSpan</input>
      <output clear="false">humRate</output>
    </formula>

    <count>
      <input clear="false">recording</input>
      <output clear="false">micN</output>
    </count>

    <formula formula="min(min([1],[2]),[3])">
      <input clear="false">accN</input>
      <input clear="false">magN</input>
      <input clear="false">micN</input>
      <output>coreOk</output>
    </formula>
    <divide>
      <input clear="false">accRate</input>
      <input type="value">2</input>
      <output>vibMax</output>
    </divide>
  </analysis>

  <export>
    <set name="Device report">
      <data name="Accelerometer rate (Hz)">accRate</data>
      <data name="Gyroscope rate (Hz)">gyrRate</data>
      <data name="Magnetometer rate (Hz)">magRate</data>
      <data name="Barometer rate (Hz)">preRate</data>
      <data name="Light rate (Hz)">lgtRate</data>
      <data name="Proximity rate (Hz)">prxRate</data>
      <data name="Ambient temperature rate (Hz)">tmpRate</data>
      <data name="Humidity rate (Hz)">humRate</data>
      <data name="Microphone rate (Hz)">micRate</data>
      <data name="Accelerometer noise (m/s^2)">accNoise</data>
      <data name="Magnetometer noise (uT)">magNoise</data>
      <data name="Gyroscope noise (rad/s)">gyrNoise</data>
      <data name="Highest vibration frequency (Hz)">vibMax</data>
    </set>
    <set name="Sample counts">
      <data name="Accelerometer">accN</data>
      <data name="Gyroscope">gyrN</data>
      <data name="Magnetometer">magN</data>
      <data name="Barometer">preN</data>
      <data name="Light">lgtN</data>
      <data name="Proximity">prxN</data>
      <data name="Ambient temperature">tmpN</data>
      <data name="Humidity">humN</data>
      <data name="Microphone">micN</data>
    </set>
  </export>
</phyphox>
