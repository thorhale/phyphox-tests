<phyphox version="1.14" locale="en">
  <title>Vibration Census</title>
  <category>Data centre</category>
  <icon>VIB</icon>
  <description>
        WHAT IT DOES
        Tells you which machines are really running, by feeling the floor.

        HOW
        Every spinning machine shakes the building a tiny bit. The shake happens at a rate set by how fast the machine turns. We measure that rate in Hz, which means times per second. A CRAC (a big room air conditioner), a chiller (a machine that makes cold water), a pump and a transformer (a box that changes the voltage of the electricity) all turn at different speeds. So each one leaves its own line. One recording of the floor holds a line for each of them.

        WHY YOU CARE
        Some machines run when they should not. A room often has a duty unit (the one meant to be working) and a backup unit (the spare). A backup unit can quietly run next to the duty unit for months, burning double the energy for nothing. This is a real and common fault. You cannot spot it on a walk round, because both units look completely normal.

        HOW TO RUN IT
        1. Put the phone FLAT ON THE FLOOR, screen up, and take your hand off it.
        2. Press play and leave it for a minute.
        3. Read the Census tab.

        Holding it ruins the reading. Your hand shakes far more than the building does. This is the most common way to get a useless result.

        A raised floor sits on short legs called pedestals. If you can, put the phone right over a pedestal. The middle of a floor tile bends and blurs everything.

        READING IT
        Multiply any peak by 60 to get the rough RPM, which means turns per minute. A peak is a pitch that is stronger than the ones next to it. 50 or 60 Hz is the mains, the electricity in the wall sockets, which flips 50 or 60 times a second. 100 or 120 Hz is usually a transformer or motor. It hums at twice the mains rate, because its iron core gets squeezed twice in every flip. Spinning hard drives show up here too. Look near 90 Hz for 5400 turns-per-minute drives, or 120 Hz for 7200.

        WHEN
        Take a baseline once. A baseline is a first reading you compare everything else against. Then repeat monthly and compare. A new line that was not there before means something new is running, or something old has changed. As a one off it tells you very little. As a habit it is one of the most useful things here.

        CHECK FIRST
        Run Device Check. Your phone measures shaking with a sensor called the accelerometer. The fastest shake it can see is half its own reading rate. On a slow phone that ceiling may be only 50 Hz.
    </description>

  <data-containers>
    <container size="2048">aAbs</container>
    <container size="2048">aT</container>
    <container>aN</container>
    <container>aT0</container>
    <container>aTL</container>
    <container>aSpan</container>
    <container>aRate</container>
    <container>aRateHalf</container>
    <container>aMean</container>
    <container>aRms</container>

    <container size="2048">aDet</container>
    <container size="2048">winU</container>
    <container size="2048">win</container>
    <container size="2048">windowed</container>
    <container size="2048">re</container>
    <container size="2048">im</container>
    <container>nHalf</container>
    <container>nHalf1</container>
    <container size="1025">freq</container>
    <container size="1024">halfF</container>
    <container size="1024">halfRe</container>
    <container size="1024">halfIm</container>
    <container size="1024">mag</container>

    <container init="0">seeded</container>
    <container size="1024">peakNew</container>
    <container size="1024" init="0">peakHold</container>

    <container>iFrom</container>
    <container size="1024">bandF</container>
    <container size="1024">bandMag</container>
    <container>peakF</container>
    <container>peakRpm</container>
    <container>peakLevel</container>

    <!-- velocity RMS in mm/s, over 10 Hz .. Nyquist (ISO 10816 band) -->
    <container>iVel</container>
    <container size="1024">velF</container>
    <container size="1024">velMag</container>
    <container size="1024">velPow</container>
    <container>sumVelPow</container>
    <container>velMS</container>
    <container>velRms</container>

  </data-containers>

  <input>
    <sensor type="accelerometer" rate="0">
      <output component="abs">aAbs</output>
      <output component="t">aT</output>
    </sensor>
  </input>

  <views>
    <view label="Census">
      <info label="Phone flat on the floor. Leave it for a minute - the longer it runs, the more machines it catches."/>
      <separator height="0.5"/>
      <value label="Strongest machine tone" unit="Hz" size="2" precision="2">
        <input>peakF</input>
      </value>
      <value label="which is a shaft turning at" unit="RPM" size="2" precision="0">
        <input>peakRpm</input>
      </value>
      <separator height="0.5"/>
      <graph label="Peak hold - every tone seen so far" logY="true" labelX="Frequency" unitX="Hz" labelY="Level" unitY="a.u.">
        <input axis="x">halfF</input>
        <input axis="y">peakHold</input>
      </graph>
      <info label="Each bump is a machine. Read its frequency off the bottom axis and multiply by 60 for RPM."/>
      <button label="Clear the peak hold">
        <input type="value">0</input>
        <output>seeded</output>
      </button>
    </view>

    <view label="Live spectrum">
      <info label="A spectrum is a list of which pitches a shake is made of. This graph shows that list right now, updating live."/>
      <graph label="Right now" logY="true" labelX="Frequency" unitX="Hz" labelY="Level" unitY="a.u.">
        <input axis="x">halfF</input>
        <input axis="y">mag</input>
      </graph>
      <separator height="0.5"/>
      <value label="Overall vibration" unit="m/s^2" precision="4">
        <input>aRms</input>
      </value>
      <value label="Overall vibration speed (10 Hz and up)" unit="mm/s" precision="3">
        <input>velRms</input>
      </value>
      <info label="The mm/s number is vibration SPEED, the unit machine-health standards (ISO 10816 and 20816) are written in. On the floor it adds up every machine at once, so read it as how much this spot is moving - to judge one machine, put the phone on that machine. See the Fan test for a per-machine health verdict."/>
      <value label="Is anything actually running">
        <input>aRms</input>
        <map max="0.003">nothing - the floor is dead still</map>
        <map max="0.02">faint - something is running somewhere</map>
        <map max="0.1">clear machinery nearby</map>
        <map>strong - you are on or beside a running machine</map>
      </value>
    </view>

    <view label="This phone's limits">
      <value label="Accelerometer sample rate" unit="Hz" precision="1">
        <input>aRate</input>
      </value>
      <value label="Highest frequency visible" unit="Hz" size="2" precision="1">
        <input>aRateHalf</input>
      </value>
      <value label="Highest shaft speed visible" unit="RPM" precision="0">
        <input>peakRpm</input>
      </value>
      <separator height="0.5"/>
      <info label="Anything spinning faster than the limit above is invisible here. Worse, it does not just vanish. It folds back down and shows up as a peak at some lower pitch that matches no real machine. This is like a wagon wheel in a film. Spin it fast enough and it looks like it turns slowly backwards. If you see a line you cannot explain, suspect this first."/>
      <separator height="0.5"/>
      <info label="Frequency resolution means how finely it can tell two close pitches apart. It is the sample rate divided by 2048. At 200 Hz that is about 0.1 Hz, or 6 turns per minute. That is fine enough to tell two matching fans apart when one runs slightly slow."/>
    </view>

    <view label="Notes">
      <info label="TURNING A PEAK INTO SOMETHING YOU RECOGNISE"/>
      <info label="A peak at 50 means something is turning 50 times a second. Multiply by 60 for the turns per minute, so that is a 3000 turns-per-minute shaft."/>
      <info label="50 or 60 Hz is the mains itself, the electricity in the wall sockets. 100 or 120 Hz is usually a transformer. A transformer hums at TWICE the mains rate. Its iron core gets squeezed twice in every flip, once each way. So a 60 Hz supply gives a 120 Hz hum."/>
      <info label="Around 90 Hz is a spinning hard drive at 5400 turns per minute. Around 120 Hz is one at 7200."/>
      <separator height="0.5"/>
      <info label="TWO PEAKS ALMOST TOUCHING"/>
      <info label="Two machines running at almost the same speed make a slow throb as they drift in and out of step. You can hear it in the room as a steady pulsing. It is a very common cause of noise complaints. It bothers people more than a louder but steady sound."/>
      <separator height="0.5"/>
      <info label="IT CANNOT TELL YOU WHICH MACHINE"/>
      <info label="It only tells you that something at that speed is running somewhere. The floor ties the whole room together. That is what makes it good for counting the whole room, and useless for blaming one unit."/>
      <info label="To pin it down, put the phone directly on a specific machine and watch which line grows."/>
      <separator height="0.5"/>
      <info label="THE LEVELS ARE NOT REAL UNITS"/>
      <info label="The level is shown in a.u. That means the number only means something next to another number from the same test. Do not compare these numbers with another phone's, or with anything published. They only mean something next to THIS phone, in another place, or the same place at another time."/>
      <info label="That is not a weakness for this job. Which machines are running, and has that changed, are both comparisons."/>
      <separator height="0.5"/>
      <info label="WORDS THIS USES"/>
      <info label="Hz - times per second."/>
      <info label="RPM - turns per minute. To convert, multiply Hz by 60."/>
      <info label="Spectrum - a list of which pitches a shake is made of."/>
      <info label="Peak - a pitch that is stronger than the ones next to it."/>
      <info label="a.u. - the number only means something next to another number from the same test."/>
      <info label="Mains - the electricity in the wall sockets, which flips 50 or 60 times a second."/>
      <info label="Transformer - a box that changes the voltage of the electricity, and hums at twice the mains rate."/>
      <info label="Accelerometer - the sensor in your phone that measures shaking."/>
      <info label="Baseline - a first reading you compare everything else against."/>
      <info label="Folds back - a fast shake the phone cannot see shows up as a fake slow one, like a wagon wheel that looks like it spins backwards on film."/>
      <info label="Frequency resolution - how finely it can tell two close pitches apart."/>
    </view>
  </views>

  <analysis sleep="0.5">
    <count>
      <input clear="false">aT</input>
      <output clear="false">aN</output>
    </count>
    <first>
      <input as="value" clear="false">aT</input>
      <output as="first">aT0</output>
    </first>
    <max>
      <input as="y" clear="false">aT</input>
      <output as="max">aTL</output>
    </max>
    <subtract>
      <input>aTL</input>
      <input>aT0</input>
      <output>aSpan</output>
    </subtract>
    <formula formula="max([1]-1,1)/max([2],0.001)">
      <input clear="false">aN</input>
      <input>aSpan</input>
      <output clear="false">aRate</output>
    </formula>
    <divide>
      <input clear="false">aRate</input>
      <input type="value">2</input>
      <output clear="false">aRateHalf</output>
    </divide>

    <average>
      <input as="buffer" clear="false">aAbs</input>
      <output as="average">aMean</output>
      <output as="stddev" clear="false">aRms</output>
    </average>
    <formula formula="[1_]-[2]">
      <input clear="false">aAbs</input>
      <input>aMean</input>
      <output>aDet</output>
    </formula>

    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" type="value">1</input>
      <input as="length" clear="false">aN</input>
      <output>winU</output>
    </ramp>
    <formula formula="0.5-0.5*cos(6.283185307179586*[1_])">
      <input>winU</input>
      <output>win</output>
    </formula>
    <multiply>
      <input as="factor">aDet</input>
      <input as="factor">win</input>
      <output>windowed</output>
    </multiply>
    <fft>
      <input>windowed</input>
      <output as="re">re</output>
      <output as="im">im</output>
    </fft>
    <divide>
      <input clear="false">aN</input>
      <input type="value">2</input>
      <output clear="false">nHalf</output>
    </divide>
    <add>
      <input clear="false">nHalf</input>
      <input type="value">1</input>
      <output>nHalf1</output>
    </add>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" clear="false">aRateHalf</input>
      <input as="length" clear="false">nHalf1</input>
      <output>freq</output>
    </ramp>
    <subrange>
      <input as="from" type="value">1</input>
      <input as="to" clear="false">nHalf</input>
      <input as="in">freq</input>
      <input as="in">re</input>
      <input as="in">im</input>
      <output>halfF</output>
      <output>halfRe</output>
      <output>halfIm</output>
    </subrange>
    <formula formula="sqrt([1_]*[1_]+[2_]*[2_])">
      <input>halfRe</input>
      <input>halfIm</input>
      <output>mag</output>
    </formula>

    <!-- Overall vibration in mm/s velocity, the unit ISO 10816/20816 uses.
         Velocity power per bin = acceleration power / (2*pi*f)^2. Summed from
         10 Hz up (below that a phone's own noise, divided by f^2, blows up),
         scaled by 5.3333/N^2 (2 for the single-sided spectrum / 0.375 for the
         Hann window power), square-rooted, and x1000 for mm/s. Verified against
         a synthetic sine to 0.02%. -->
    <formula formula="max(round(10*[1]/[2])-1,0)">
      <input clear="false">aN</input>
      <input clear="false">aRate</input>
      <output>iVel</output>
    </formula>
    <subrange>
      <input as="from" clear="false">iVel</input>
      <input as="in" clear="false">halfF</input>
      <input as="in" clear="false">mag</input>
      <output>velF</output>
      <output>velMag</output>
    </subrange>
    <formula formula="[1_]*[1_]/((6.283185307179586*[2_])*(6.283185307179586*[2_]))">
      <input>velMag</input>
      <input>velF</input>
      <output>velPow</output>
    </formula>
    <integrate>
      <input>velPow</input>
      <output>sumVelPow</output>
    </integrate>
    <formula formula="5.333333333333333*[1]/([2]*[2])">
      <input>sumVelPow</input>
      <input clear="false">aN</input>
      <output>velMS</output>
    </formula>
    <formula formula="1000*sqrt([1])">
      <input>velMS</input>
      <output>velRms</output>
    </formula>

    <!-- peak hold: keep the highest level ever seen in each bin -->
    <formula formula="max([1_],[2_])">
      <input clear="false">peakHold</input>
      <input clear="false">mag</input>
      <output>peakNew</output>
    </formula>
    <if less="true">
      <input clear="false">seeded</input>
      <input type="value">0.5</input>
      <input clear="false">mag</input>
      <input>peakNew</input>
      <output>peakHold</output>
    </if>
    <append>
      <input type="value">1</input>
      <output>seeded</output>
    </append>

    <!-- strongest tone, ignoring the lowest bins which carry drift -->
    <formula formula="max(round(2*[1]/[2])-1,0)">
      <input clear="false">aN</input>
      <input clear="false">aRate</input>
      <output>iFrom</output>
    </formula>
    <subrange>
      <input as="from" clear="false">iFrom</input>
      <input as="in" clear="false">halfF</input>
      <input as="in" clear="false">peakHold</input>
      <output>bandF</output>
      <output>bandMag</output>
    </subrange>
    <max>
      <input as="x">bandF</input>
      <input as="y">bandMag</input>
      <output as="position" clear="false">peakF</output>
      <output as="max">peakLevel</output>
    </max>
    <multiply>
      <input as="factor" clear="false">peakF</input>
      <input as="factor" type="value">60</input>
      <output>peakRpm</output>
    </multiply>
  </analysis>

  <export>
    <set name="Peak hold spectrum">
      <data name="Frequency (Hz)">halfF</data>
      <data name="Highest level seen (a.u.)">peakHold</data>
      <data name="Level right now (a.u.)">mag</data>
    </set>
    <set name="Summary">
      <data name="Strongest tone (Hz)">peakF</data>
      <data name="Implied shaft speed (RPM)">peakRpm</data>
      <data name="Overall vibration (m/s^2)">aRms</data>
      <data name="Accelerometer rate (Hz)">aRate</data>
      <data name="Highest visible frequency (Hz)">aRateHalf</data>
    </set>
  </export>
</phyphox>
