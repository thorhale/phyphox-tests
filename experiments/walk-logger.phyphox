<phyphox version="1.14" locale="en">
  <title>Synchronised Walk Logger</title>
  <category>Data centre</category>
  <icon>WLK</icon>
  <description>
        WHAT IT IS
        The recorder. Not a test - the thing you run while you do everything else.

        It records noise, magnetic field, light, air pressure, tilt and your walking pace all at once, against a single clock, with a button to mark any spot.

        WHY YOU CARE
        Walk the hall once and you get one file with everything lined up on the same timeline. Then you work out what you wanted to know afterwards - including things you did not think to look for at the time. That is the difference between a survey and a second trip.

        Every row carries a real world timestamp, so anything else recorded on the same walk - a WiFi app's log, thermal camera shots, a note on your phone - can be matched up to it afterwards by time alone.

        HOW TO RUN IT
        1. Start at a point whose location you actually know.
        2. Walk at a steady pace.
        3. Press Waypoint at anything you can identify later: a column, a tile grid reference, the end of a row.
        4. Export as CSV when you are done.

        The recording keeps running between waypoints, so you can place readings along the walk by working out how far between two known points you were.

        BEFORE YOU START
        Check the phone's clock is right. If a second device is involved, clap once in front of both at the start - then you can CHECK that they line up afterwards, rather than hoping.
    </description>

  <data-containers>
    <!-- microphone: broadband level only -->
    <container size="8192">recording</container>
    <container>micRate</container>
    <container>micCnt</container>
    <container>micFrom</container>
    <container size="4096">micBlock</container>
    <container>micN</container>
    <container size="4096">micSq</container>
    <container>micSum</container>
    <container>micMs</container>
    <container>micLn</container>
    <container>micDb</container>

    <!-- magnetometer, light, barometer -->
    <container size="64">bAbs</container>
    <container>bNow</container>
    <container size="64">lux</container>
    <container>luxNow</container>
    <container size="64">pres</container>
    <container>presNow</container>

    <!-- accelerometer: tilt and cadence -->
    <container size="1024">aX</container>
    <container size="1024">aY</container>
    <container size="1024">aZ</container>
    <container size="1024">aAbs</container>
    <container size="1024">aT</container>
    <container>aCnt</container>
    <container>aT0</container>
    <container>aTLast</container>
    <container>aSpan</container>
    <container>aRate</container>
    <container>aMean</container>
    <container>aStd</container>
    <container size="1024">aDet</container>
    <container size="1024">aWinU</container>
    <container size="1024">aWin</container>
    <container size="1024">aWindowed</container>
    <container size="1024">aRe</container>
    <container size="1024">aIm</container>
    <container>aNHalf</container>
    <container>aNHalf1</container>
    <container>aRateHalf</container>
    <container size="513">aFreq</container>
    <container size="512">aHalfF</container>
    <container size="512">aHalfRe</container>
    <container size="512">aHalfIm</container>
    <container size="512">aMag</container>
    <container>cadFrom</container>
    <container>cadTo</container>
    <container size="512">cadF</container>
    <container size="512">cadMag</container>
    <container>cadence</container>

    <container>axm</container>
    <container>aym</container>
    <container>azm</container>
    <container>slopeY</container>

    <!-- clock and step accumulation -->
    <container>now</container>
    <container>epochOffset</container>
    <container>epochNow</container>
    <container init="0">prevNow</container>
    <container>dt</container>
    <container>dStep</container>
    <container>dStepG</container>
    <container init="0">stepsAcc</container>
    <container>stepsNew</container>

    <!-- continuous trace -->
    <container size="0">hT</container>
    <container size="0">hDb</container>
    <container size="0">hB</container>
    <container size="0">hLux</container>
    <container size="0">hP</container>

    <!-- waypoints -->
    <container init="0">logNow</container>
    <container size="0">wpEpoch</container>
    <container size="0">wpDb</container>
    <container size="0">wpB</container>
    <container size="0">wpLux</container>
    <container size="0">wpP</container>
    <container size="0">wpSlope</container>
    <container size="0">wpSteps</container>
    <container>wpCount</container>
  </data-containers>

  <input>
    <audio append="true">
      <output>recording</output>
      <output component="rate">micRate</output>
    </audio>
    <sensor type="magnetic_field" rate="0" ignoreUnavailable="true">
      <output component="abs">bAbs</output>
    </sensor>
    <sensor type="light" rate="0" ignoreUnavailable="true">
      <output component="x">lux</output>
    </sensor>
    <sensor type="pressure" rate="0" ignoreUnavailable="true">
      <output component="x">pres</output>
    </sensor>
    <sensor type="accelerometer" rate="0">
      <output component="x">aX</output>
      <output component="y">aY</output>
      <output component="z">aZ</output>
      <output component="abs">aAbs</output>
      <output component="t">aT</output>
    </sensor>
  </input>

  <views>
    <view label="Walk">
      <value label="Waypoints recorded" size="2" precision="0">
        <input>wpCount</input>
      </value>
      <button label="Waypoint">
        <input type="value">1</input>
        <output>logNow</output>
      </button>
      <separator height="0.5"/>
      <value label="Sound level (uncalibrated)" unit="dBFS" precision="1">
        <input>micDb</input>
      </value>
      <value label="Magnetic field" unit="uT" precision="2">
        <input>bNow</input>
      </value>
      <value label="Illuminance" unit="lx" precision="0">
        <input>luxNow</input>
      </value>
      <value label="Pressure" unit="hPa" precision="2">
        <input>presNow</input>
      </value>
      <value label="Slope of the phone" unit="mm/m" precision="1">
        <input>slopeY</input>
      </value>
      <separator height="0.5"/>
      <value label="Cadence" unit="steps/s" precision="2">
        <input>cadence</input>
      </value>
      <value label="Steps (estimated)" precision="0">
        <input>stepsAcc</input>
      </value>
      <value label="Movement">
        <input>aStd</input>
        <map max="0.5">standing still</map>
        <map max="2">moving slowly</map>
        <map>walking</map>
      </value>
    </view>

    <view label="Traces">
      <graph label="Sound level" labelX="Time" unitX="s" labelY="Level" unitY="dBFS" partialUpdate="true">
        <input axis="x">hT</input>
        <input axis="y">hDb</input>
      </graph>
      <graph label="Magnetic field" labelX="Time" unitX="s" labelY="Flux density" unitY="uT" partialUpdate="true">
        <input axis="x">hT</input>
        <input axis="y">hB</input>
      </graph>
      <graph label="Illuminance" labelX="Time" unitX="s" labelY="Illuminance" unitY="lx" partialUpdate="true">
        <input axis="x">hT</input>
        <input axis="y">hLux</input>
      </graph>
      <graph label="Pressure" labelX="Time" unitX="s" labelY="Pressure" unitY="hPa" partialUpdate="true">
        <input axis="x">hT</input>
        <input axis="y">hP</input>
      </graph>
    </view>

    <view label="Cadence detail">
      <info label="Cadence is the strongest peak between 1.2 and 3.5 Hz in the spectrum of total acceleration - the rhythm of walking. Step count is that cadence integrated over time, and only accumulates while the phone judges you to be moving."/>
      <separator height="0.5"/>
      <value label="Accelerometer sample rate" unit="Hz" precision="1">
        <input>aRate</input>
      </value>
      <value label="Movement (std dev)" unit="m/s^2" precision="3">
        <input>aStd</input>
      </value>
      <graph label="Acceleration spectrum" labelX="Frequency" unitX="Hz" labelY="Magnitude" unitY="a.u.">
        <input axis="x">aHalfF</input>
        <input axis="y">aMag</input>
      </graph>
    </view>

    <view label="Notes">
      <info label="WHY IT DOES NOT DRAW YOU A MAP"/>
      <info label="Because the map would be wrong, and worse, it would look right."/>
      <info label="To track yourself by walking you need to know which way you are facing. Indoors that comes from the magnetometer, which in a hall full of steel is wrong by tens of degrees and changes as you move. The alternative, adding up turns from the gyroscope, drifts by degrees every minute."/>
      <info label="Either way the path curls up into a shape that looks like a plausible walk and is not one. A wrong map you trust is worse than no map."/>
      <separator height="0.5"/>
      <info label="SO PRESS THE WAYPOINT BUTTON INSTEAD"/>
      <info label="Press it at things you can identify afterwards - a column, a tile reference, the end of a row. Those are certain. Everything recorded between two waypoints can be spaced out along the gap later."/>
      <info label="The step count helps you do that spacing. It is an estimate, not a tally - good enough to say you were about two thirds of the way down a row, nowhere near good enough to count individual paces."/>
      <info label="How rough is it? About 2.5 percent out on a phone reading its accelerometer 100 times a second, and about 10 percent on one reading it 400 times a second."/>
      <info label="Yes, the FASTER phone is worse here, which looks backwards. The pace is worked out from a fixed length chunk of readings, so a faster phone covers less time in that chunk and sees the rhythm less finely. Faster is better for vibration and worse for this."/>
      <separator height="0.5"/>
      <info label="LINING UP WITH OTHER RECORDINGS"/>
      <info label="Every row carries a real world timestamp, so a WiFi app's export, camera shots and this file can all be joined by time afterwards."/>
      <info label="Two things to do first. Check the phone's clock is right. And if a second device is involved, clap once in front of both at the start - that gives you a shared event so you can CHECK the alignment instead of assuming it. Assumed alignment fails silently, which is the worst way for anything to fail."/>
      <separator height="0.5"/>
      <info label="HOW MUCH TO TRUST EACH COLUMN"/>
      <info label="Slope - the best thing here, but only while the phone is still."/>
      <info label="Magnetic field - accurate."/>
      <info label="Pressure - good for comparing, but the absolute value can be several units out."/>
      <info label="Sound level - comparative only, and NOT dB(A). Use the Sound Level Meter if you need a proper noise figure."/>
      <info label="Light - roughly right, and reads low whenever the sensor is shaded or tilted. Keep the phone flat and face up."/>
      <separator height="0.5"/>
      <info label="MISSING SENSORS DO NOT BREAK IT"/>
      <info label="Anything your phone does not have is skipped rather than stopping the recording. No barometer or no light sensor just leaves those columns empty."/>
    </view>
  </views>

  <analysis sleep="0.25">

    <!-- clock -->
    <timer>
      <output as="out">now</output>
      <output as="offset1970">epochOffset</output>
    </timer>
    <add>
      <input clear="false">now</input>
      <input>epochOffset</input>
      <output clear="false">epochNow</output>
    </add>
    <subtract>
      <input clear="false">now</input>
      <input clear="false">prevNow</input>
      <output>dt</output>
    </subtract>
    <append>
      <input clear="false">now</input>
      <output>prevNow</output>
    </append>

    <!-- sound level, broadband, uncalibrated -->
    <count>
      <input clear="false">recording</input>
      <output>micCnt</output>
    </count>
    <formula formula="max([1]-4096,0)">
      <input>micCnt</input>
      <output>micFrom</output>
    </formula>
    <subrange>
      <input as="from" clear="false">micFrom</input>
      <input as="in" clear="false">recording</input>
      <output>micBlock</output>
    </subrange>
    <count>
      <input clear="false">micBlock</input>
      <output>micN</output>
    </count>
    <multiply>
      <input as="factor" clear="false">micBlock</input>
      <input as="factor">micBlock</input>
      <output>micSq</output>
    </multiply>
    <integrate>
      <input>micSq</input>
      <output>micSum</output>
    </integrate>
    <formula formula="[1]/max([2],1)+0.000000000001">
      <input>micSum</input>
      <input>micN</input>
      <output>micMs</output>
    </formula>
    <log>
      <input>micMs</input>
      <output>micLn</output>
    </log>
    <formula formula="4.342944819032518*[1]">
      <input>micLn</input>
      <output clear="false">micDb</output>
    </formula>

    <!-- smoothed current value of each slow sensor -->
    <average>
      <input as="buffer" clear="false">bAbs</input>
      <output as="average" clear="false">bNow</output>
    </average>
    <average>
      <input as="buffer" clear="false">lux</input>
      <output as="average" clear="false">luxNow</output>
    </average>
    <average>
      <input as="buffer" clear="false">pres</input>
      <output as="average" clear="false">presNow</output>
    </average>

    <!-- tilt -->
    <average>
      <input as="buffer" clear="false">aX</input>
      <output as="average">axm</output>
    </average>
    <average>
      <input as="buffer" clear="false">aY</input>
      <output as="average">aym</output>
    </average>
    <average>
      <input as="buffer" clear="false">aZ</input>
      <output as="average">azm</output>
    </average>
    <formula formula="1000*[1]/max(sqrt([2]*[2]+[3]*[3]),0.001)">
      <input>aym</input>
      <input>axm</input>
      <input>azm</input>
      <output clear="false">slopeY</output>
    </formula>

    <!-- accelerometer rate from its own timestamps -->
    <count>
      <input clear="false">aT</input>
      <output clear="false">aCnt</output>
    </count>
    <first>
      <input as="value" clear="false">aT</input>
      <output as="first">aT0</output>
    </first>
    <max>
      <input as="y" clear="false">aT</input>
      <output as="max">aTLast</output>
    </max>
    <subtract>
      <input>aTLast</input>
      <input>aT0</input>
      <output>aSpan</output>
    </subtract>
    <formula formula="max([1]-1,1)/max([2],0.001)">
      <input clear="false">aCnt</input>
      <input>aSpan</input>
      <output clear="false">aRate</output>
    </formula>

    <!-- cadence from the spectrum of total acceleration -->
    <average>
      <input as="buffer" clear="false">aAbs</input>
      <output as="average">aMean</output>
      <output as="stddev" clear="false">aStd</output>
    </average>
    <formula formula="[1_]-[2]">
      <input clear="false">aAbs</input>
      <input>aMean</input>
      <output>aDet</output>
    </formula>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop" type="value">1</input>
      <input as="length" clear="false">aCnt</input>
      <output>aWinU</output>
    </ramp>
    <formula formula="0.5-0.5*cos(6.283185307179586*[1_])">
      <input>aWinU</input>
      <output>aWin</output>
    </formula>
    <multiply>
      <input as="factor">aDet</input>
      <input as="factor">aWin</input>
      <output>aWindowed</output>
    </multiply>
    <fft>
      <input>aWindowed</input>
      <output as="re">aRe</output>
      <output as="im">aIm</output>
    </fft>
    <divide>
      <input clear="false">aRate</input>
      <input type="value">2</input>
      <output>aRateHalf</output>
    </divide>
    <divide>
      <input clear="false">aCnt</input>
      <input type="value">2</input>
      <output clear="false">aNHalf</output>
    </divide>
    <add>
      <input clear="false">aNHalf</input>
      <input type="value">1</input>
      <output>aNHalf1</output>
    </add>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="stop">aRateHalf</input>
      <input as="length" clear="false">aNHalf1</input>
      <output>aFreq</output>
    </ramp>
    <subrange>
      <input as="from" type="value">1</input>
      <input as="to" clear="false">aNHalf</input>
      <input as="in">aFreq</input>
      <input as="in">aRe</input>
      <input as="in">aIm</input>
      <output>aHalfF</output>
      <output>aHalfRe</output>
      <output>aHalfIm</output>
    </subrange>
    <formula formula="sqrt([1_]*[1_]+[2_]*[2_])">
      <input>aHalfRe</input>
      <input>aHalfIm</input>
      <output>aMag</output>
    </formula>
    <formula formula="max(round(1.2*[1]/[2])-1,0)">
      <input clear="false">aCnt</input>
      <input clear="false">aRate</input>
      <output>cadFrom</output>
    </formula>
    <formula formula="max(round(3.5*[1]/[2])-1,1)">
      <input clear="false">aCnt</input>
      <input clear="false">aRate</input>
      <output>cadTo</output>
    </formula>
    <subrange>
      <input as="from" clear="false">cadFrom</input>
      <input as="to" clear="false">cadTo</input>
      <input as="in" clear="false">aHalfF</input>
      <input as="in" clear="false">aMag</input>
      <output>cadF</output>
      <output>cadMag</output>
    </subrange>
    <max>
      <input as="x">cadF</input>
      <input as="y">cadMag</input>
      <output as="position" clear="false">cadence</output>
    </max>

    <!-- step accumulation, gated on actually moving -->
    <multiply>
      <input as="factor" clear="false">cadence</input>
      <input as="factor">dt</input>
      <output>dStep</output>
    </multiply>
    <if greater="true">
      <input clear="false">aStd</input>
      <input type="value">0.5</input>
      <input>dStep</input>
      <input type="value">0</input>
      <output>dStepG</output>
    </if>
    <add>
      <input clear="false">stepsAcc</input>
      <input>dStepG</input>
      <output>stepsNew</output>
    </add>
    <append>
      <input clear="false">stepsNew</input>
      <output clear="false">stepsAcc</output>
    </append>

    <!-- continuous trace -->
    <append>
      <input clear="false">now</input>
      <output clear="false">hT</output>
    </append>
    <append>
      <input clear="false">micDb</input>
      <output clear="false">hDb</output>
    </append>
    <append>
      <input clear="false">bNow</input>
      <output clear="false">hB</output>
    </append>
    <append>
      <input clear="false">luxNow</input>
      <output clear="false">hLux</output>
    </append>
    <append>
      <input clear="false">presNow</input>
      <output clear="false">hP</output>
    </append>

    <!-- waypoint -->
    <if equal="true">
      <input clear="false">logNow</input>
      <input type="value">1</input>
      <input clear="false">epochNow</input>
      <output clear="false">wpEpoch</output>
    </if>
    <if equal="true">
      <input clear="false">logNow</input>
      <input type="value">1</input>
      <input clear="false">micDb</input>
      <output clear="false">wpDb</output>
    </if>
    <if equal="true">
      <input clear="false">logNow</input>
      <input type="value">1</input>
      <input clear="false">bNow</input>
      <output clear="false">wpB</output>
    </if>
    <if equal="true">
      <input clear="false">logNow</input>
      <input type="value">1</input>
      <input clear="false">luxNow</input>
      <output clear="false">wpLux</output>
    </if>
    <if equal="true">
      <input clear="false">logNow</input>
      <input type="value">1</input>
      <input clear="false">presNow</input>
      <output clear="false">wpP</output>
    </if>
    <if equal="true">
      <input clear="false">logNow</input>
      <input type="value">1</input>
      <input clear="false">slopeY</input>
      <output clear="false">wpSlope</output>
    </if>
    <if equal="true">
      <input clear="false">logNow</input>
      <input type="value">1</input>
      <input clear="false">stepsAcc</input>
      <output clear="false">wpSteps</output>
    </if>
    <append>
      <input type="value">0</input>
      <output>logNow</output>
    </append>
    <count>
      <input clear="false">wpEpoch</input>
      <output>wpCount</output>
    </count>
  </analysis>

  <export>
    <set name="Waypoints">
      <data name="Timestamp (Unix s)">wpEpoch</data>
      <data name="Sound level (dBFS)">wpDb</data>
      <data name="Magnetic field (uT)">wpB</data>
      <data name="Illuminance (lx)">wpLux</data>
      <data name="Pressure (hPa)">wpP</data>
      <data name="Slope (mm/m)">wpSlope</data>
      <data name="Steps">wpSteps</data>
    </set>
    <set name="Continuous trace">
      <data name="Time (s)">hT</data>
      <data name="Sound level (dBFS)">hDb</data>
      <data name="Magnetic field (uT)">hB</data>
      <data name="Illuminance (lx)">hLux</data>
      <data name="Pressure (hPa)">hP</data>
    </set>
  </export>
</phyphox>
